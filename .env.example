# Copy to .env and fill in. .env is gitignored.

# anthropic | openai | nvidia
LLM_PROVIDER=anthropic

ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-5

OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# build.nvidia.com NIM endpoint. NVIDIA_MODEL is primary; NVIDIA_FALLBACK_MODELS
# is a comma-separated list tried in order if the primary errors, times out, or
# fails to return a valid structured (tool-call) response.
#
# Chosen by empirically probing this account's models against the ACTUAL
# interpret schema (7 fields), not a toy example - several well-known models
# either 404'd on this account, or passed a simplified smoke test but then
# timed out completely on the real schema (mistral-nemotron, kimi-k3). See
# docs/DESIGN.md "Model selection" for the full method and results.
NVIDIA_API_KEY=
NVIDIA_MODEL=nvidia/nemotron-3-ultra-550b-a55b
NVIDIA_FALLBACK_MODELS=openai/gpt-oss-20b,nvidia/nemotron-3.5-lightning-30b-a3b
NVIDIA_TIMEOUT=45

# Path to the policy file. Editable at runtime without a restart.
SOP_FILE=sops/sops.yaml
