{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "weather-bot-web",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["run", "dev", "--prefix", "web"],
      "port": 3000,
      "autoPort": true
    },
    {
      "name": "weather-bot-streamlit",
      "runtimeExecutable": ".venv/Scripts/python.exe",
      "runtimeArgs": ["-m", "streamlit", "run", "frontend/streamlit_app.py", "--server.headless", "true"],
      "port": 8501,
      "autoPort": true
    }
  ]
}
